# 复制本文件为 .env 后填入真实值。切勿把填写后的 .env 提交到 Git。

# 模型提供商：qwen | openai_compatible （两者都走 OpenAI 兼容 chat/completions 协议）
LLM_PROVIDER=qwen
# 真实 API Key，仅后端读取。留空则 /llm/test 返回 LLM_KEY_NOT_CONFIGURED
LLM_API_KEY=
# OpenAI 兼容根地址，不含 /chat/completions 后缀。
# qwen 默认：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名，按账号实际可用模型填写
LLM_MODEL=qwen-plus
# 请求超时（秒）
LLM_TIMEOUT=60
# 最大重试次数（不含首次请求），0 表示不重试
LLM_MAX_RETRIES=1

# 数据库连接串（SQLite 起步）
DATABASE_URL=sqlite+aiosqlite:///./reprocheck.db
# 同步迁移用的连接串（Alembic）
SYNC_DATABASE_URL=sqlite:///./reprocheck.db

# 连接测试/审计演示接口的访问令牌。留空则开发模式下不校验。
# 生产环境必须设置，否则任何访问者都能消耗你的 API 额度。
ADMIN_TOKEN=
# 是否允许未配置 ADMIN_TOKEN 时访问受保护接口（仅开发环境可用）
# 生产必须为 false。可用 GET /api/v1/diagnosis/production-check 自检。
ALLOW_UNAUTH_TEST_ENDPOINTS=true

# JWT 签名密钥：生产必须设为 32 位以上随机值
JWT_SECRET=dev-insecure-change-me
# 数据加密密钥：生产必须单独设置 16 位以上随机值（不要复用 JWT_SECRET）
ENCRYPTION_KEY=
# 第十一阶段：用户模型 API 凭据专用加密密钥（独立 Fernet key 或强口令）。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 为空时拒绝创建用户级 API 凭据，模型管理中心不可用；绝不与数据库同处存放。
MODEL_CREDENTIAL_KEY=
# 仅开发/内网测试允许 http://localhost 自定义模型端点；生产必须 false
ALLOW_LOCAL_MODEL_ENDPOINT=false
# 开启后调用外部 LLM 前必须有有效 AI 授权；生产建议 true
REQUIRE_AI_CONSENT=false
# CORS 允许的来源，逗号分隔（也支持 JSON 数组）；生产收敛为前端域名，禁止 *
CORS_ALLOW_ORIGINS=*

# 生产严格模式：设为 1/true 后，若生产安全检查不通过则拒绝启动
STRICT_PRODUCTION=0

# 服务端监听
HOST=0.0.0.0
PORT=8000
