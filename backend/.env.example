# =============================================================================
# ReproCheck 后端环境变量模板（backend/.env.example）
# -----------------------------------------------------------------------------
# 用法：复制本文件为 backend/.env，再按需填入真实值。
#       backend/.env 已在 .gitignore 中忽略，绝不提交 Git。
#       本文件不得包含任何真实密钥；留空的项使用 config.py 中的默认值。
# 读取顺序：backend/.env → 项目根 .env（两份都存在时，同名变量以进程环境变量为准）。
# 参考：backend/app/core/config.py 的 Settings 字段一一对应。
# =============================================================================

# ---------- 1. LLM（审计演示 /demo/audit、AI 诊断、抽取与风险解释均依赖此项）----------
# 模型提供商：qwen | openai_compatible（两者都走 OpenAI 兼容 chat/completions 协议）
LLM_PROVIDER=qwen
# 真实 API Key，仅后端读取，永不返回前端。
# 留空时 /demo/audit 与 /llm/test 返回 503，code=LLM_KEY_NOT_CONFIGURED（这是如实报错，不是兜底成功）。
LLM_API_KEY=
# OpenAI 兼容根地址，不带 /chat/completions 后缀。
# qwen 默认：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名，按账号实际可用模型填写（如 qwen-plus / qwen-max）
LLM_MODEL=qwen-plus
# 单次请求超时（秒），必须 > 0
LLM_TIMEOUT=60
# 失败重试次数（不含首次请求），0-5
LLM_MAX_RETRIES=1

# ---------- 2. 数据库 ----------
# 异步连接串（应用运行时使用）
# 未设置时使用 backend/reprocheck.db；自定义 SQLite 路径请使用绝对路径。
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/reprocheck.db
# 同步连接串（Alembic 迁移使用）
# SYNC_DATABASE_URL=sqlite:////absolute/path/to/reprocheck.db

# ---------- 3. 身份与凭据安全 ----------
# 连接测试 / 审计演示等管理接口的访问令牌。留空则开发模式下不校验。
ADMIN_TOKEN=
# 是否允许未配置 ADMIN_TOKEN 时访问受保护接口（仅开发环境；生产必须 false）
ALLOW_UNAUTH_TEST_ENDPOINTS=false
STRICT_PRODUCTION=false
# JWT 签名密钥：生产必须为 32 位以上随机值
JWT_SECRET=dev-insecure-change-me
# JWT 有效期（小时）
JWT_EXPIRE_HOURS=12
# 数据加密密钥：生产必须单独设置 16 位以上随机值，不要复用 JWT_SECRET
ENCRYPTION_KEY=
# 用户级模型 API 凭据专用加密密钥（独立 Fernet key 或强口令）。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 为空时拒绝创建用户级 API 凭据，模型管理中心不可用；绝不与数据库同处存放。
MODEL_CREDENTIAL_KEY=
# 仅开发/内网测试允许 http://localhost 自定义模型端点；生产必须 false
ALLOW_LOCAL_MODEL_ENDPOINT=false
# 开启后调用外部 LLM 前必须有有效 AI 授权；生产建议 true
REQUIRE_AI_CONSENT=false
# 首个管理员账号（首次启动引导用，可留空）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# 邀请链接有效天数
INVITATION_EXPIRE_DAYS=7
# 开放 API 默认限流（次/分钟）
OPEN_API_DEFAULT_RATE_LIMIT=60
# 数据保留天数
DATA_RETENTION_DAYS=365

# ---------- 4. 服务与请求 ----------
HOST=0.0.0.0
PORT=8000
# CORS 允许的来源：支持 JSON 数组 ["https://a.com"] 或逗号分隔写法；生产收敛为前端域名，禁止 *
CORS_ALLOW_ORIGINS_RAW=*
# 单次请求体上限（字节），默认 1MB
MAX_REQUEST_BYTES=1048576

# ---------- 5. 安全隔离执行（默认全关：无安全容器时绝不执行用户代码）----------
ENABLE_CODE_EXECUTION=false
# 执行后端：none | rootless_docker | gvisor（本地默认 none）
EXECUTION_BACKEND=none
# 单次执行超时（秒）
EXECUTION_TIMEOUT_SECONDS=300
# 最大 CPU 时间（秒）
EXECUTION_MAX_CPU_SECONDS=120
# 最大内存（MB）
EXECUTION_MAX_MEMORY_MB=2048
# 最大进程数
EXECUTION_MAX_PIDS=128
# 是否允许执行环境联网（默认禁止）
EXECUTION_ALLOW_NETWORK=false

# ---------- 6. 科研工作流编排（第七阶段策略上限）----------
# 单轮并发执行的节点数（1-8）
WORKFLOW_MAX_CONCURRENT_NODES=1
# 单节点超时（秒），必须 > 0
WORKFLOW_NODE_TIMEOUT_SECONDS=300
# 自动重试次数上限（0-5）
WORKFLOW_MAX_AUTO_RETRIES=2
# 心跳过期回收阈值（分钟），必须 > 0
WORKFLOW_STALE_MINUTES=15
