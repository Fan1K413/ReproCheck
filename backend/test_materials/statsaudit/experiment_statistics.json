{
  "dataset_id": "statsaudit-experiment-statistics-fixture-v1",
  "description": "实验统计计算引擎的端到端测试数据集；expected 中的数值均由公开公式手工核算，保留 6 位小数。",
  "payload_schema": {
    "claims": "对象，论文/调用方报告的统计值，如 {mean, std}",
    "samples": "原始样本，可为数组或 {values: [...], ddof: 1}",
    "runs": "多次运行记录数组，每项为 {name, values} 或 {name, mean, std}",
    "seed_scores": "对象，键为随机种子标识，值为该种子下的分数数组",
    "group_a": "第一组样本数组",
    "group_b": "第二组样本数组",
    "alpha": "显著性水平",
    "test_kind": "welch / student / paired / mannwhitney / one_sample",
    "paired": "是否配对",
    "mu0": "单样本检验的原假设均值",
    "pvalues": "多重比较的原始 p 值数组",
    "multiple_method": "bonferroni / holm / bh / by",
    "effect_kind": "cohens_d / hedges_g / glass_delta",
    "effect_size": "功效分析用的标准化效应量",
    "n": "功效分析用的每组样本量",
    "power": "目标功效（反解样本量时使用）",
    "power_kind": "two_sample / one_sample",
    "ci_level": "置信水平",
    "ci_method": "t / normal",
    "outlier_method": "iqr / modified_z",
    "outlier_threshold": "异常识别阈值",
    "bins": "直方图分箱数"
  },
